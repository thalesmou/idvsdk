{
  "name": "@gbgplc/smartcapture-web",
  "description": "Docs & Bio Web Components",
  "license": "SEE LICENSE IN EULA.txt",
  "author": "GBG Plc",
  "version" :"2.3.0",
  "type": "module",
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.es.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": "./dist/lib/index.es.js",
    "./face": "./dist/lib/face/index.js",
    "./document": "./dist/lib/document/index.js",
    "./image": "./dist/lib/image/index.js"
  },
  "files": [
    "dist/lib",
    "dist/assets",
    "dist/custom-elements.json",
    "EULA.txt"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.js",
    "prepare": "yarn --cwd demo install && (cd demo/node_modules/$npm_package_name && rimraf demo node_modules dist && mkdir dist) && ln -sf \"$PWD\"/dist/* demo/node_modules/$npm_package_name/dist && husky install",
    "dev": "yarn build && concurrently -k -r \"wds\" \"rollup -c rollup.config.js --watch\"",
    "start": "concurrently -k -r \"wds\" \"rollup -c rollup.config.js --watch\"",
    "start-only": "wds",
    "build": "rimraf dist && tsc && rollup -c rollup.config.js && yarn analyze && node -e \"const p=require('./package.json');require('node:fs').writeFileSync('demo/version.js','globalThis.__SDK_VERSION__='+JSON.stringify(p.version)+';');\"",
    "build:prod": "rimraf dist && tsc && NODE_ENV=production rollup -c rollup.config.js && yarn analyze",
    "prepublish": "yarn build",
    "lint": "eslint . && prettier \"**/*.ts\" --check --ignore-path .gitignore",
    "lint-for-ci": "eslint . -f json -o eslint-out.json",
    "format": "eslint . --fix && prettier \"**/*.ts\" --write --ignore-path .gitignore",
    "test": "rimraf dist && tsc -p tsconfig.test.json && rollup -c rollup.config.js && wtr --coverage",
    "test-only": "wtr --coverage",
    "test:watch": "tsc -p tsconfig.test.json && concurrently -k -r \"tsc -p tsconfig.test.json --watch --preserveWatchOutput\" \"wtr --watch\"",
    "co:login": "aws codeartifact login --tool npm --repository smartcapture-web --domain gbgplc --domain-owner 266130098155 --region eu-west-2 --namespace @gbgplc"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@gbgplc/stickman-wasm": "1.100.2",
    "@lottiefiles/dotlottie-wc": "^0.9.18",
    "idlive-face-capture-web": "file:idlive-face-capture-web-development-2.5.5.tgz",
    "lit": "^3.3.3",
    "piexifjs": "^1.0.6",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^4.0.0",
    "@preemptive/jsdefender-core": "file:preemptive-jsdefender-core-2.10.0.tgz",
    "@preemptive/jsdefender-rollup-plugin": "file:preemptive-jsdefender-rollup-plugin-2.10.0.tgz",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/mocha": "^10.0.10",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-puppeteer": "^0.18.0",
    "caniuse-lite": "^1.0.30001797",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin": "^1.0.1",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-wc": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.61.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-dts": "^6.4.1",
    "sinon": "^22.0.0",
    "sonar-scanner": "^3.1.0",
    "typescript": "^6.0.3"
  },
  "resolutions": {
    "errorstacks": "2.4.1"
  },
  "customElements": "custom-elements.json",
  "prettier": {
    "singleQuote": true,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "bundleDependencies": [
    "@gbgplc/stickman-wasm",
    "idlive-face-capture-web"
  ],
  "_jsdefender": {
    "techDebt": "Tarballs are vendored locally as a workaround until @preemptive packages are available on CodeArtifact. Migrate to registry when possible so upgrades are auditable.",
    "integrity": {
      "preemptive-jsdefender-core-2.10.0.tgz": "sha256:295606a1672ee286afd6a8bf2004dc42d4026a1d6d127fa6ca952b4bcd5a25b8",
      "preemptive-jsdefender-rollup-plugin-2.10.0.tgz": "sha256:6d95f1bad15e9dc2da7456bf5031aec3ba38389f8784b2a3f3267dcc42297add"
    }
  }
}
